{
    "configurations": [
        {
            "name": "Shopping.API",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/Shopping/Shopping.API/Shopping.API.csproj"
        },
        {
            "name": "Shopping.Client",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/Shopping/Shopping.Client/Shopping.Client.csproj"
        },
        {
            "name": "Shopping.API Debug (Docker)",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "platform": "netCore",
            "netCore": {
                "appProject": "${workspaceFolder}/Shopping/Shopping.API/Shopping.API.csproj"
            }
        },
        {
            "name": "Shopping.Client Debug (Docker)",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "platform": "netCore",
            "netCore": {
                "appProject": "${workspaceFolder}/Shopping/Shopping.Client/Shopping.Client.csproj"
            }
        },
        {
            "name": "Containers: .NET Launch",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "netCore": {
                "appProject": "${workspaceFolder}/Shopping/Shopping.Client/Shopping.Client.csproj"
            }
        }
    ],
    "compounds": [
        {
            "name": "Shopping API and Client",
            "configurations": ["Shopping.API","Shopping.Client"]
        },
        {
      
            "name": "Launch Web + API (Docker)",
            "configurations": [
                "Shopping.API Debug (Docker)",
                "Shopping.Client Debug (Docker)"
            ],
            "stopAll": true
        }
    ]
}